FROM python:3.13-slim
WORKDIR /app
RUN pip install --no-cache-dir "fastapi==0.136.3" "uvicorn==0.52.4"
COPY l1_demo /app/l1_demo
COPY mock-attestation /app/mock-attestation
COPY key-broker /app/key-broker
CMD ["uvicorn", "app:app", "--app-dir", "/app/mock-attestation", "--host", "0.0.0.0", "--port", "8080"]
